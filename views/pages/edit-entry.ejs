<%- include('../partials/header', { pageTitle: 'Edit Entry' }) %>

<h1>Edit Your Diary Entry</h1>

<% if (typeof entry !== 'undefined') { %>
  <!-- The form's action points to the specific update route -->
  <form action="/entries/update/<%= entry.id %>" method="POST">
    <label for="title">Title</label>
    <div>
      <!-- The 'value' attribute is pre-filled with the existing title -->
      <input type="text" id="title" name="title" value="<%= entry.title %>" required>
    </div>
    <label for="content">Content</label>
    <div>
      <!-- The textarea is pre-filled with the existing content between its tags -->
      <textarea id="content" name="content" rows="10" required><%= entry.content %></textarea>
    </div>
    <button type="submit">Save Changes</button>
  </form>
<% } else { %>
  <p>Sorry, we couldn't find that entry.</p>
<% } %>

<a href="/dashboard">Back to Dashboard</a>

<%- include('../partials/footer') %>